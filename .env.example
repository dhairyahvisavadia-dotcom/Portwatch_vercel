# ==============================================================================
# PortWatch — Environment Configuration Specification (.env)
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment.
# All settings are strictly validated at application startup.

# ------------------------------------------------------------------------------
# Security & Session Authentication
# ------------------------------------------------------------------------------
# Flask secret key for signing session cookies and CSRF tokens.
# In production, generate a secure 64-char hex key:
# python -c "import secrets; print(secrets.token_hex(32))"
PORTWATCH_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Session inactivity timeout in minutes (Integer between 1 and 1440, default: 2)
# Set to 15-60 for standard production environments, or 2 for testing / demos.
PORTWATCH_SESSION_MINUTES=2

# Environment Mode: "development", "testing", or "production"
# Setting to "production" enforces secure HTTPS-only session cookies and strict headers.
PORTWATCH_ENV=development

# ------------------------------------------------------------------------------
# Server Binding
# ------------------------------------------------------------------------------
# Network host address to bind the web server (Default: 0.0.0.0)
PORTWATCH_HOST=0.0.0.0

# TCP port to bind the web application (Integer 1-65535, Default: 5000)
PORTWATCH_PORT=5000

# Flask debug mode (0 for disabled, 1 for enabled — keep 0 in production)
FLASK_DEBUG=0

# ------------------------------------------------------------------------------
# Database Persistence (SQLite or PostgreSQL)
# ------------------------------------------------------------------------------
# Database URL connection string.
# - If omitted or blank: Defaults to local zero-configuration SQLite (portwatch.db / portwatch_auth.db)
# - For Cloud PostgreSQL (Neon, Supabase, Railway, Render, Vercel Postgres):
#   DATABASE_URL=postgresql+pg8000://username:password@ep-host.us-east-2.aws.neon.tech/portwatch?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# Scanner & Network Probing Parameters
# ------------------------------------------------------------------------------
# Background subnet sweep interval in seconds (Integer between 1 and 3600, default: 20)
PORTWATCH_SCAN_INTERVAL=20

# Cloud Showcase / Interactive Demonstration Mode
# Set to true when deploying on serverless or cloud platforms without local Wi-Fi hardware.
# Automatically generates realistic dynamic client nodes, latency metrics, and network traffic.
PORTWATCH_DEMO_MODE=false
