# PortWatch Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Flask secret key for signing session cookies.
# In production, generate a secure 64-char hex key: python -c "import secrets; print(secrets.token_hex(32))"
PORTWATCH_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Session timeout in minutes (default is 2 minutes for testing / university demo, or set to 15-60)
PORTWATCH_SESSION_MINUTES=2

# Environment: "development" or "production"
# Setting to "production" enables secure HTTPS-only session cookies and strict security flags
PORTWATCH_ENV=development

# Server bind host and port
PORTWATCH_HOST=0.0.0.0
PORTWATCH_PORT=5000

# Flask debug mode (0 for off, 1 for on - keep 0 in production)
FLASK_DEBUG=0

# Database Configuration (Optional for Cloud / PostgreSQL deployment):
# If omitted or empty, PortWatch defaults to local SQLite files (portwatch.db / portwatch_auth.db).
# For cloud deployment (Supabase, Neon, Railway, Render, Vercel), provide your PostgreSQL connection string:
# DATABASE_URL=postgresql+pg8000://username:password@ep-cool-flower-12345.us-east-2.aws.neon.tech/portwatch?sslmode=require

# Cloud Showcase / Interactive Demonstration Mode
# Set to true when deploying on serverless or cloud platforms without local physical Wi-Fi hardware.
# Automatically simulates realistic client nodes, latency metrics, and network traffic.
PORTWATCH_DEMO_MODE=false

# Subnet sweep background monitoring interval (in seconds, default: 20)
PORTWATCH_SCAN_INTERVAL=20

