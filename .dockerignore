# ==============================================================================
# PortWatch — Docker Build Ignore Rules
# ==============================================================================

# Version control
.git/
.github/
.gitignore

# Python compiled artifacts & virtualenvs
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# Environment variables & secrets
.env
.env.*
*.env

# SQLite local runtime user databases & caches
portwatch.db
portwatch_auth.db
test_*.db
*.db-journal
*.db-wal
*.db-shm
vendor_cache.json

# Test & coverage artifacts
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Docker configs & local logs
Dockerfile*
docker-compose*.yml
*.log
